# Base path of the API. Leave as /api/v1: Vite (dev, preview) and Vercel (production) both
# proxy /api to the backend, which keeps the session cookie first-party.
VITE_API_BASE_URL=/api/v1

# Google OAuth client ID (public, the same value as the backend's GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# Never put secrets in VITE_ variables: they are compiled into the public bundle.
#
# Production backend URL: vercel.json cannot read environment variables, so before deploying
# replace the placeholder host "adventuro-backend.example.com" in vercel.json with the
# backend's real host on Render.
